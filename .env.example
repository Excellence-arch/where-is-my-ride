# BimpeAI Agent Console API (https://api.bimpe.ai). All optional:
# without them the app runs fully in local demo mode.
BIMPEAI_API_KEY=sk_your_team_key
BIMPEAI_AGENT_ID=your_agent_id
# Override only if BimpeAI gives you a different host.
# BIMPEAI_BASE_URL=https://api.bimpe.ai

# Public URL of this deployment, used by `npm run bimpe:register-tool`
# to point the BimpeAI agent's custom tool at /api/track.
PUBLIC_APP_URL=https://your-app.vercel.app
